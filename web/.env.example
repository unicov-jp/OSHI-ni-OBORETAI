# ---- 画面だけ確認する(Supabase等に接続しない。架空データで表示) ----
# 本番では必ず空にすること
NEXT_PUBLIC_DEMO_MODE=

# ---- サイト ----
# 本番のURL(末尾スラッシュなし)。Stripeの戻り先に使う
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
# 公開してよい鍵(Publishable key。旧 anon key でも可)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 秘密鍵(Secret key。旧 service_role key でも可)。サーバー専用。NEXT_PUBLIC_ を付けないこと
SUPABASE_SECRET_KEY=

# ---- 定期取得 ----
# 推測されない長い文字列(例: openssl rand -hex 32)。Vercel Cron が Authorization ヘッダーで送る
CRON_SECRET=
# 取得間隔(分)。最短15
FETCH_INTERVAL_MINUTES=60
# 新着の保存日数
ITEM_RETENTION_DAYS=30

# ---- YouTube Data API v3 (任意) ----
# 未設定でも /channel/UC... 形式のURLは登録できる。@handle 形式の登録に必要
YOUTUBE_API_KEY=

# ---- Stripe (未設定なら申し込みボタンは表示されない) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
