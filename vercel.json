{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "redirects": [
    { "source": "/web", "destination": "/", "permanent": false },
    { "source": "/web/:path*", "destination": "/", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    }
  ]
}
